{
  "cli": { "appVersionSource": "remote", "requireCommit": true },
  "build": {
    "base": { "node": "22.13.0", "pnpm": "12.23.0" },
    "development": { "extends": "base", "developmentClient": true, "distribution": "internal" },
    "preview": { "extends": "base", "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "extends": "base", "autoIncrement": true, "android": { "buildType": "app-bundle" } }
  },
  "submit": { "production": { "android": { "track": "internal" } } }
}
